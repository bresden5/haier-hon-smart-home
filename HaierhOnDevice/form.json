      "type": "NumberSpinner",
      "name": "PollInterval",
      "caption": "Polling interval",
      "minimum": 0,
      "maximum": 3600
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Refresh state",
      "onClick": "HHOND_RefreshState($id);"
    },
    {
      "type": "Button",
      "caption": "Refresh command definitions",
      "onClick": "HHOND_RefreshCommands($id);"
    },
    {
      "type": "Button",
      "caption": "Pause program",
      "onClick": "HHOND_PauseProgram($id);"
    },
    {
      "type": "Button",
      "caption": "Resume program",
      "onClick": "HHOND_ResumeProgram($id);"
    },
    {
      "type": "Button",
      "caption": "Stop program",
      "onClick": "HHOND_StopProgram($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Active"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Not configured"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "Request failed"
    }
  ]
