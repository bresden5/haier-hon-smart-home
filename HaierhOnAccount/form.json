{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "Email",
      "caption": "E-mail"
    },
    {
      "type": "PasswordTextBox",
      "name": "Password",
      "caption": "Password"
    },
    {
      "type": "PasswordTextBox",
      "name": "InitialRefreshToken",
      "caption": "Refresh token"
    },
    {
      "type": "PasswordTextBox",
      "name": "ManualOAuthCallbackUrl",
      "caption": "OAuth callback URL"
    },
    {
      "type": "ValidationTextBox",
      "name": "DeviceLocation",
      "caption": "Device path"
    },
    {
      "type": "NumberSpinner",
      "name": "Timeout",
      "caption": "HTTP timeout",
      "minimum": 5,
      "maximum": 120
    },
    {
      "type": "ExpansionPanel",
      "caption": "Advanced API settings",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "AppVersion",
          "caption": "App version"
        },
        {
          "type": "ValidationTextBox",
          "name": "ClientId",
          "caption": "OAuth client ID"
        },
        {
          "type": "ValidationTextBox",
          "name": "ApiBase",
          "caption": "API base URL"
        },
        {
          "type": "ValidationTextBox",
          "name": "AuthBase",
          "caption": "Auth base URL"
        },
        {
          "type": "ValidationTextBox",
          "name": "UserAgent",
          "caption": "User agent"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Login / refresh tokens",
      "onClick": "HHONA_Login($id);"
    },
    {
      "type": "Button",
      "caption": "Import OAuth callback",
      "onClick": "HHONA_ImportOAuthCallback($id);"
    },
    {
      "type": "Button",
      "caption": "Load appliances",
      "onClick": "HHONA_RefreshAppliances($id); HHONA_UpdateConfigurator($id);"
    },
    {
      "type": "Configurator",
      "name": "ApplianceConfigurator",
      "caption": "Loaded appliances",
      "rowCount": 8,
      "delete": false,
      "columns": [
        {
          "caption": "Name",
          "name": "name",
          "width": "220px"
        },
        {
          "caption": "MAC address",
          "name": "address",
          "width": "170px"
        },
        {
          "caption": "Type",
          "name": "type",
          "width": "80px"
        },
        {
          "caption": "Model",
          "name": "model",
          "width": "180px"
        },
        {
          "caption": "Code",
          "name": "code",
          "width": "140px"
        }
      ],
      "values": []
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Connected"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Not configured"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Authentication failed"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "API request failed"
    }
  ]
}
